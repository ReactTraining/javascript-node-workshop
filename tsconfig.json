{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "jsx": "react",
    "target": "ES2022",
    // "noEmitOnError": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "noImplicitAny": false
  }
}
